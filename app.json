{
  "expo": {
    "name": "Validador",
    "slug": "Validador",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/logo_.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_.png",
        "backgroundColor": "#000fff"
      },
      "package": "com.validator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f723101d-3143-446b-90d6-53b57662a5ac"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite"
    ]
  }
}
