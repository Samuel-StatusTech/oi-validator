{
  "expo": {
    "name": "Validador",
    "slug": "Validador",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/logo_.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo_.png",
      "resizeMode": "contain",
      "backgroundColor": "#121214"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_.png",
        "backgroundColor": "#000fff"
      },
      "package": "com.validator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2fb526a5-2450-4cd9-bf01-01d30807e721"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite"
    ],
    "owner": "statustechfn"
  }
}
